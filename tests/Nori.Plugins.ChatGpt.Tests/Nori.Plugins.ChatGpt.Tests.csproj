<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<AssemblyName>Nori.Plugins.ChatGpt.Tests</AssemblyName>
		<IsPackable>false</IsPackable>
	</PropertyGroup>
	<ItemGroup>
		<!-- 单元测试不加载 SDK 的 ref-only 合同，直接使用真实 AI 抽象运行时。 -->
		<PackageReference Include="Nori.PluginSDK" Version="2.4.1" ExcludeAssets="all" />
		<PackageReference Include="Microsoft.Extensions.AI" Version="10.9.0" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
		<PackageReference Include="xunit" Version="2.9.3" />
		<PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
		<Using Include="Xunit" />
		<ProjectReference Include="../../src/Nori.Plugins.ChatGpt/Nori.Plugins.ChatGpt.csproj" />
	</ItemGroup>
	<ItemGroup Condition="'$(NoriDesktopRoot)' == ''">
		<Compile Remove="LoginPageTests.cs;PluginTests.cs" />
	</ItemGroup>
	<ItemGroup Condition="'$(NoriDesktopRoot)' != ''">
		<PackageReference Include="Avalonia.Headless" Version="12.1.1" />
		<PackageReference Include="Avalonia.Skia" Version="12.1.1" />
		<PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
		<ProjectReference Include="$(NoriDesktopRoot)/app/desktop/Nori.PluginRuntime/Nori.PluginRuntime.csproj" />
	</ItemGroup>
</Project>
